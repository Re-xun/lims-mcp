{
  "openapi": "3.0.3",
  "info": {
    "title": "Java Business API (Sample)",
    "version": "1.0.0",
    "description": "Sample API spec for testing the MCP generator. Replace with your real Java API spec."
  },
  "servers": [
    { "url": "http://localhost:8080", "description": "Java backend" }
  ],
  "paths": {
    "/api/users/{userId}": {
      "get": {
        "operationId": "getUserById",
        "tags": ["user_mcp"],
        "summary": "Get user details by ID",
        "description": "Returns user profile information including name, department, and role.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "The user ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "operationId": "searchUsers",
        "tags": ["user_mcp"],
        "summary": "Search users by keyword",
        "description": "Search users by name, department, or role. Returns a paginated list of matching users.",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "Search keyword for name/department/role",
            "schema": { "type": "string" }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Filter by department name",
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-based)",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated user list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/User" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/departments": {
      "get": {
        "operationId": "listDepartments",
        "tags": ["user_mcp"],
        "summary": "List all departments",
        "description": "Returns a list of all departments in the organization.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Department list"
          }
        }
      }
    },
    "/api/orders/{orderId}": {
      "get": {
        "operationId": "getOrderById",
        "tags": ["order_mcp"],
        "summary": "Get order details by ID",
        "description": "Returns full order details including items, status, and timeline.",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "The order ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Order details" }
        }
      }
    },
    "/api/orders": {
      "get": {
        "operationId": "searchOrders",
        "tags": ["order_mcp"],
        "summary": "Search orders with filters",
        "description": "Search orders by status, date range, or customer. Returns paginated results.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Order status filter",
            "schema": { "type": "string", "enum": ["pending", "processing", "shipped", "completed", "cancelled"] }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "description": "Start date (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "description": "End date (YYYY-MM-DD)",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": { "description": "Paginated order list" }
        }
      }
    },
    "/api/orders/statistics": {
      "get": {
        "operationId": "getOrderStatistics",
        "tags": ["order_mcp"],
        "summary": "Get order statistics overview",
        "description": "Returns aggregate statistics: total orders, revenue, average order value by time period.",
        "parameters": [
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "Statistics period",
            "schema": { "type": "string", "enum": ["today", "week", "month", "quarter", "year"], "default": "month" }
          }
        ],
        "responses": {
          "200": { "description": "Order statistics" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "description": "User profile information",
        "properties": {
          "id": { "type": "string", "description": "Unique user ID" },
          "name": { "type": "string", "description": "User's full name" },
          "email": { "type": "string", "description": "User's email address" },
          "department": { "type": "string", "description": "Department name" },
          "role": { "type": "string", "description": "User role/permission group" }
        },
        "required": ["id", "name"]
      }
    }
  }
}
